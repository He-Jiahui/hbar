{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun", "vite/client"],
    "paths": {
      "@lumen/app-ui": ["./packages/lumen-app-ui/src/index.ts"],
      "@lumen/app-ui/catalog": ["./packages/lumen-app-ui/src/catalog.ts"],
      "@lumen/app-ui/variants": ["./packages/lumen-app-ui/src/variants/index.ts"],
      "@mui/internal-test-utils": ["./tests/lumen/renderer.tsx"],
      "hbar-app-ui": ["./packages/hbar-app-ui/src/production.ts"],
      "hbar-app-ui/catalog": ["./packages/hbar-app-ui/src/catalog.ts"],
      "hbar-app-ui/catalog-metadata": ["./packages/hbar-app-ui/src/catalog-metadata.ts"],
      "hbar-app-ui/theme.css": ["./packages/hbar-app-ui/src/theme.css"],
      "hbar-app-ui/appearance": ["./packages/hbar-app-ui/src/appearance.ts"],
      "hbar-app-ui/primitives": ["./packages/hbar-app-ui/src/primitives.tsx"],
      "hbar-app-ui/icon": ["./packages/hbar-app-ui/src/icon.tsx"],
      "hbar-app-ui/types": ["./packages/hbar-app-ui/src/types.ts"],
      "hbar-app-ui/workbench": ["./packages/hbar-app-ui/src/workbench.ts"],
      "hbar-app-ui/tool-pane": ["./packages/hbar-app-ui/src/tool-pane.tsx"],
      "hbar-app-ui/conversation": ["./packages/hbar-app-ui/src/conversation.ts"],
      "hbar-app-ui/prompt-composer": ["./packages/hbar-app-ui/src/prompt-composer.ts"],
      "hbar-app-ui/workspace-files": ["./packages/hbar-app-ui/src/workspace-files.ts"],
      "hbar-app-ui/plan-editor": ["./packages/hbar-app-ui/src/plan-editor.ts"],
      "hbar-app-ui/ai-chat": ["./packages/hbar-app-ui/src/components/AiChat.tsx"],
      "hbar-app-ui/prompt-input": ["./packages/hbar-app-ui/src/components/PromptInput.tsx"],
      "hbar-app-ui/agent-activity": ["./packages/hbar-app-ui/src/components/AgentActivity.tsx"],
      "hbar-app-ui/tool-calls": ["./packages/hbar-app-ui/src/components/ToolCalls.tsx"],
      "hbar-app-ui/agent-approval": ["./packages/hbar-app-ui/src/components/AgentApproval.tsx"],
      "hbar-app-ui/approval-request": ["./packages/hbar-app-ui/src/components/ApprovalRequest.tsx"],
      "hbar-app-ui/questionnaire": ["./packages/hbar-app-ui/src/components/Questionnaire.tsx"],
      "hbar-app-ui/agent-plan": ["./packages/hbar-app-ui/src/components/AgentPlan.tsx"],
      "hbar-app-ui/ai-usage": ["./packages/hbar-app-ui/src/ai-usage.ts"],
      "hbar-app-ui/app-shell": ["./packages/hbar-app-ui/src/components/AppShell.tsx"],
      "hbar-app-ui/app-sidebar": ["./packages/hbar-app-ui/src/components/AppSidebar.tsx"],
      "hbar-app-ui/command-menu": ["./packages/hbar-app-ui/src/command-menu.ts"],
      "hbar-app-ui/navbar": ["./packages/hbar-app-ui/src/components/Navbar.tsx"],
      "hbar-app-ui/mobile": ["./packages/hbar-app-ui/src/components/Mobile.tsx"],
      "hbar-app-ui/card": ["./packages/hbar-app-ui/src/components/Card.tsx"],
      "hbar-app-ui/data-table": ["./packages/hbar-app-ui/src/components/DataTable.tsx"],
      "hbar-app-ui/dashboard": ["./packages/hbar-app-ui/src/components/Dashboard.tsx"],
      "hbar-app-ui/analytics": ["./packages/hbar-app-ui/src/components/Analytics.tsx"],
      "hbar-app-ui/list": ["./packages/hbar-app-ui/src/components/List.tsx"],
      "hbar-app-ui/filtering": ["./packages/hbar-app-ui/src/components/Filtering.tsx"],
      "hbar-app-ui/file-manager": ["./packages/hbar-app-ui/src/components/FileManager.tsx"],
      "hbar-app-ui/monitoring": ["./packages/hbar-app-ui/src/components/Monitoring.tsx"],
      "hbar-app-ui/empty-state": ["./packages/hbar-app-ui/src/components/EmptyState.tsx"],
      "hbar-app-ui/settings-form": ["./packages/hbar-app-ui/src/settings-form.ts"],
      "hbar-app-ui/forms": ["./packages/hbar-app-ui/src/forms.ts"],
      "hbar-app-ui/app-dialog": ["./packages/hbar-app-ui/src/app-dialog.ts"],
      "hbar-app-ui/notifications": ["./packages/hbar-app-ui/src/components/Notifications.tsx"],
      "hbar-app-ui/onboarding": ["./packages/hbar-app-ui/src/components/Onboarding.tsx"],
      "hbar-app-ui/paywall": ["./packages/hbar-app-ui/src/components/Paywall.tsx"],
      "hbar-app-ui/authentication": ["./packages/hbar-app-ui/src/authentication.ts"],
      "hbar-app-ui/kanban": ["./packages/hbar-app-ui/src/components/Kanban.tsx"],
      "hbar-app-ui/wizard": ["./packages/hbar-app-ui/src/components/Wizard.tsx"],
      "hbar-app-ui/comments": ["./packages/hbar-app-ui/src/components/Comments.tsx"],
      "hbar-app-ui/scheduling": ["./packages/hbar-app-ui/src/components/Scheduling.tsx"],
      "hbar-app-ui/integrations": ["./packages/hbar-app-ui/src/components/Integrations.tsx"],
      "hbar-app-ui/editor": ["./packages/hbar-app-ui/src/components/Editor.tsx"],
      "hbar-app-ui/feedback": ["./packages/hbar-app-ui/src/components/Feedback.tsx"],
      "hbar-app-ui/support": ["./packages/hbar-app-ui/src/components/Support.tsx"],
      "hbar-app-ui/billing": ["./packages/hbar-app-ui/src/components/Billing.tsx"],
      "hbar-app-ui/chat": ["./packages/hbar-app-ui/src/components/Chat.tsx"],
      "hbar-app-ui/run-activity": ["./packages/hbar-app-ui/src/components/RunActivity.tsx"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "plugins/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "e2e/**/*.ts",
    "e2e/**/*.tsx",
    "examples/**/*.ts",
    "playwright.config.ts",
    "vitest.lumen.config.ts",
    "vitest.app-react.config.ts"
  ],
  "exclude": ["node_modules", "dist", "**/artifacts/**", "apps/desktop/src-tauri/target"]
}
