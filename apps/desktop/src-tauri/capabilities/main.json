{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Desktop window lifecycle; business operations use the authenticated Host protocol.",
  "webviews": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": [
    "core:default",
    "notification:default",
    "allow-connection-info",
    "allow-resource-browser",
    "allow-resource-open-system",
    "allow-open-tool-window",
    "allow-focus-tool-window",
    "allow-close-tool-window",
    "allow-pick-directory",
    "allow-list-fonts",
    "allow-set-window-effect",
    "allow-read-ui-zoom",
    "allow-write-ui-zoom",
    "allow-native-notification-permission",
    "allow-request-native-notification-permission",
    "allow-send-native-notification",
    "allow-native-notification-delivery-status",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-is-visible",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-toggle-maximize"
  ]
}
