{
  "name": "hbar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "hbar": "apps/cli/src/main.ts"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*",
    "hbar-ui/packages/lumen-app-ui"
  ],
  "scripts": {
    "dev": "bun run native:build && bun scripts/dev.ts",
    "host": "bun run native:build && bun apps/host/src/main.ts",
    "cli": "bun run native:build && bun apps/cli/src/main.ts",
    "hbar": "bun run native:build && bun apps/cli/src/main.ts",
    "pair": "bun scripts/pair.ts",
    "web": "vite --config apps/web/vite.config.ts",
    "app-ui:preview": "vite --config apps/hbar-app-ui-preview/vite.config.ts",
    "app-ui:build": "vite build --config apps/hbar-app-ui-preview/vite.config.ts",
    "app-ui:verify": "bun scripts/verify-hbar-app-ui-preview.ts",
    "app-ui:editor:verify": "bun scripts/verify-hbar-app-ui-editor.ts",
    "app-ui:navbar:verify": "bun scripts/verify-hbar-app-ui-navbar.ts",
    "app-ui:tool-calls:verify": "bun scripts/verify-hbar-app-ui-tool-calls.ts",
    "app-ui:agent-activity:verify": "bun scripts/verify-hbar-app-ui-agent-activity.ts",
    "app-ui:agent-approval:verify": "bun scripts/verify-hbar-app-ui-agent-approval.ts",
    "app-ui:usage:verify": "bun scripts/verify-hbar-app-ui-usage.ts",
    "app-ui:agent-plan:verify": "bun scripts/verify-hbar-app-ui-agent-plan.ts",
    "app-ui:file-manager:verify": "bun scripts/verify-hbar-app-ui-file-manager.ts",
    "app-ui:feedback:verify": "bun scripts/verify-hbar-app-ui-feedback.ts",
    "app-ui:settings-form:verify": "bun scripts/verify-hbar-app-ui-settings-form.ts",
    "app-ui:authentication:verify": "bun scripts/verify-hbar-app-ui-authentication.ts",
    "app-ui:billing:verify": "bun scripts/verify-hbar-app-ui-billing.ts",
    "app-ui:visual-capture": "bun scripts/capture-hbar-app-ui-visual-baseline.ts",
    "app-ui:reactbits:discover": "bun scripts/reactbits-pro-audit.ts discover",
    "app-ui:reactbits:capture": "bun scripts/reactbits-pro-audit.ts capture",
    "app-ui:reactbits:interactions": "bun scripts/reactbits-pro-audit.ts interactions",
    "app-ui:reactbits:compare": "bun scripts/reactbits-pro-audit.ts compare",
    "app-ui:reactbits:audit": "bun scripts/reactbits-pro-audit.ts audit",
    "build": "vite build --config apps/web/vite.config.ts",
    "native:build": "bun scripts/build-native-tools.ts",
    "build:cli": "bun run native:build && bun build --compile apps/cli/src/main.ts packages/storage/src/worker.ts --outfile dist/hbar.exe --external @aws-sdk/client-s3 --external chromium-bidi/lib/cjs/bidiMapper/BidiMapper --external chromium-bidi/lib/cjs/cdp/CdpConnection",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "bun run native:build && bun test tests --timeout 20000",
    "test:e2e": "playwright test",
    "bench": "bun scripts/benchmark.ts",
    "bench:workspace-query": "bun run native:build && bun scripts/benchmark-workspace-query.ts",
    "desktop": "bun scripts/desktop.ts dev",
    "desktop:dev": "bun scripts/desktop.ts dev",
    "desktop:build": "bun scripts/desktop.ts build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run native:build && bun run lint && bun run typecheck && bun test tests --timeout 20000"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.11",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@hbar/client": "workspace:*",
    "@hbar/commands": "workspace:*",
    "@hbar/app-react": "workspace:*",
    "@hbar/app-runtime": "workspace:*",
    "@hbar/contracts": "workspace:*",
    "@hbar/budget": "workspace:*",
    "@hbar/browser-use": "workspace:*",
    "@hbar/computer-use": "workspace:*",
    "@hbar/git": "workspace:*",
    "@hbar/goal": "workspace:*",
    "@hbar/kernel": "workspace:*",
    "@hbar/local-tools": "workspace:*",
    "@hbar/metrics": "workspace:*",
    "@hbar/pi-driver": "workspace:*",
    "@hbar/plugin-sdk": "workspace:*",
    "@hbar/plan": "workspace:*",
    "@hbar/schema-core": "workspace:*",
    "@hbar/schema-react": "workspace:*",
    "@hbar/settings-core": "workspace:*",
    "@hbar/storage": "workspace:*",
    "@hbar/usage": "workspace:*",
    "@hbar/workflow": "workspace:*",
    "@hbar/ui-sdk": "workspace:*",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@tanstack/react-virtual": "3.14.11",
    "@tauri-apps/api": "2.11.1",
    "@xyflow/react": "12.11.6",
    "cordis": "4.0.0-rc.9",
    "flexlayout-react": "0.10.8",
    "lucide-react": "1.43.0",
    "mermaid": "11.17.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "unzipper": "0.12.5",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/bun": "1.4.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/semver": "7.8.0",
    "@types/unzipper": "0.10.11",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "0.8.3",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2"
  }
}
