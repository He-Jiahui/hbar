{
  "name": "hbar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "hbar": "apps/cli/src/main.ts"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "host": "bun apps/host/src/main.ts",
    "cli": "bun apps/cli/src/main.ts",
    "hbar": "bun apps/cli/src/main.ts",
    "pair": "bun scripts/pair.ts",
    "web": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "build:cli": "bun build --compile apps/cli/src/main.ts --outfile dist/hbar.exe",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "bun test tests --timeout 20000",
    "test:e2e": "playwright test",
    "bench": "bun scripts/benchmark.ts",
    "desktop": "bun scripts/desktop.ts dev",
    "desktop:dev": "bun scripts/desktop.ts dev",
    "desktop:build": "bun scripts/desktop.ts build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run lint && bun run typecheck && bun test tests --timeout 20000"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.11",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@hbar/client": "workspace:*",
    "@hbar/contracts": "workspace:*",
    "@hbar/budget": "workspace:*",
    "@hbar/browser-use": "workspace:*",
    "@hbar/computer-use": "workspace:*",
    "@hbar/git": "workspace:*",
    "@hbar/goal": "workspace:*",
    "@hbar/kernel": "workspace:*",
    "@hbar/local-tools": "workspace:*",
    "@hbar/pi-driver": "workspace:*",
    "@hbar/plugin-sdk": "workspace:*",
    "@hbar/plan": "workspace:*",
    "@hbar/storage": "workspace:*",
    "@hbar/ui-sdk": "workspace:*",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@tanstack/react-virtual": "3.14.11",
    "@tauri-apps/api": "2.11.1",
    "@xyflow/react": "12.11.6",
    "cordis": "4.0.0-rc.9",
    "flexlayout-react": "0.10.8",
    "lucide-react": "1.43.0",
    "mermaid": "11.17.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "unzipper": "0.12.5",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/bun": "1.4.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/semver": "7.8.0",
    "@types/unzipper": "0.10.11",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "0.8.3",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2"
  }
}
